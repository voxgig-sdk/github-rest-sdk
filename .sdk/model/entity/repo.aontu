      t: "`$STRING`"
    }
    language: {
      h: "Language"
      n: "language"
      r: false
      t: "`$STRING`"
    }
    location: {
      h: "Location"
      n: "location"
      r: false
      t: "`$STRING`"
    }
    login: {
      h: "Login"
      n: "login"
      r: false
      sh: "The user's GitHub username"
      t: "`$STRING`"
    }
    name: {
      h: "Name"
      n: "name"
      r: false
      sh: "The name of the repository"
      t: "`$STRING`"
    }
    node_id: {
      h: "Node Id"
      n: "node_id"
      r: false
      t: "`$STRING`"
    }
    open_issues_count: {
      h: "Open Issues Count"
