# Entity: repo

main: kit: entity: repo: {

  alias: field: {}

  alias: {
    field: {
      "github-rest_id": "id"
    }
  }

  fields: {
    avatar_url: {
      fo: "uri"
      h: "Avatar Url"
      n: "avatar_url"
      r: false
      sh: "URL to the user's avatar image"
      t: "`$STRING`"
    }
    bio: {
      h: "Bio"
      n: "bio"
      r: false
      t: "`$STRING`"
    }
    blog: {
      h: "Blog"
      n: "blog"
      r: false
      t: "`$STRING`"
    }
    company: {
      h: "Company"
      n: "company"
      r: false
      t: "`$STRING`"
    }
    created_at: {
      fo: "date-time"
      h: "Created At"
      n: "created_at"
      r: false
      t: "`$STRING`"
    }
    default_branch: {
      h: "Default Branch"
      n: "default_branch"
      r: false
      t: "`$STRING`"
    }
    description: {
      h: "Description"
      n: "description"
      r: false
      t: "`$STRING`"
    }
    email: {
      fo: "email"
      h: "Email"
      n: "email"
      r: false
      t: "`$STRING`"
    }
    followers: {
      h: "Followers"
      n: "followers"
      r: false
      t: "`$INTEGER`"
    }
    following: {
      h: "Following"
      n: "following"
      r: false
      t: "`$INTEGER`"
    }
    fork: {
      h: "Fork"
      n: "fork"
      r: false
      t: "`$BOOLEAN`"
    }
    forks_count: {
      h: "Forks Count"
      n: "forks_count"
      r: false
      t: "`$INTEGER`"
    }
    full_name: {
      h: "Full Name"
      n: "full_name"
      r: false
      sh: "The full name including owner"
      t: "`$STRING`"
    }
    "github-rest_id": {
      h: "Github Rest Id"
      n: "github-rest_id"
      r: false
      sh: "The user's unique identifier"
      t: "`$INTEGER`"
    }
    html_url: {
      fo: "uri"
      h: "Html Url"
      n: "html_url"
      r: false
      t: "`$STRING`"
    }
    id: {
      h: "Id"
