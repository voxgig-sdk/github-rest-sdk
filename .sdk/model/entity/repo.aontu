      t: "`$INTEGER`"
    }
    pushed_at: {
      fo: "date-time"
      h: "Pushed At"
      n: "pushed_at"
      r: false
      t: "`$STRING`"
    }
    size: {
      h: "Size"
      n: "size"
      r: false
      t: "`$INTEGER`"
    }
    stargazers_count: {
      h: "Stargazers Count"
      n: "stargazers_count"
