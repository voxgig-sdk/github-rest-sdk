    watchers_count: {
      h: "Watchers Count"
      n: "watchers_count"
      r: false
      t: "`$INTEGER`"
    }
  }

  id: {
    field: "id"
    from: {
      owner: "owner.login"
      repo: "name"
    }
    name: "id"
    parts: [
      "owner"
      "repo"
    ]
    sep: "/"
  }

  name: "repo"
  op: {
    list: {
      name: "list"
      points: [
        {
          co: {
            id: "GET /users/{username}/repos"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "username"
                or: "username"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: "asc"
                k: "query"
                n: "direction"
                or: "direction"
                r: false
                t: "`$STRING`"
              }
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "full_name"
                k: "query"
                n: "sort"
                or: "sort"
                r: false
                t: "`$STRING`"
              }
              {
                ex: "owner"
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/users/{username}/repos"
          q: {
            exist: [
              "direction"
              "page"
              "per_page"
              "sort"
              "type"
              "username"
            ]
          }
          s: [
            {
              lit: "users"
            }
            {
              var: "username"
            }
            {
              lit: "repos"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          co: {
            id: "GET /orgs/{org}/repos"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "org_id"
                or: "org"
                r: true
                t: "`$STRING`"
              }
            ]
            query: [
              {
                ex: 1
                k: "query"
                n: "page"
                or: "page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: 30
                k: "query"
                n: "per_page"
                or: "per_page"
                r: false
                t: "`$INTEGER`"
              }
              {
                ex: "all"
                k: "query"
                n: "type"
                or: "type"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/orgs/{org}/repos"
          q: {
            exist: [
              "org_id"
              "page"
              "per_page"
              "type"
            ]
          }
          r: {
            param: {
              org: "org_id"
            }
          }
          s: [
            {
              lit: "orgs"
            }
            {
              var: "org_id"
            }
            {
              lit: "repos"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /repos/{owner}/{repo}"
            source: "openapi3"
            version: 2
          }
          g: {
            params: [
              {
                k: "param"
                n: "owner"
                or: "owner"
                r: true
                t: "`$STRING`"
              }
              {
                k: "param"
                n: "repo"
                or: "repo"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/repos/{owner}/{repo}"
          q: {
            exist: [
              "owner"
              "repo"
            ]
          }
          s: [
            {
              lit: "repos"
            }
            {
              var: "owner"
            }
            {
              var: "repo"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.owner`"
          }
        }
      ]
    }
  }


  relations: ancestors: [
    [path("$.main.kit.entity.org")]
    [path("$.main.kit.entity.user")]
  ]

}
