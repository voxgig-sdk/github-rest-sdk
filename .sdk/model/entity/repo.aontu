      r: false
      t: "`$INTEGER`"
    }
    owner: {
      h: "Owner"
      n: "owner"
      r: false
      t: "`$OBJECT`"
    }
    private: {
      h: "Private"
      n: "private"
      r: false
      sh: "Whether the repository is private"
      t: "`$BOOLEAN`"
    }
    public_gists: {
      h: "Public Gists"
      n: "public_gists"
      r: false
      t: "`$INTEGER`"
    }
    public_repos: {
      h: "Public Repos"
